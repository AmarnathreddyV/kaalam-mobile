# Server-side secrets. Configure these in Render's environment settings.
NAVAMSHA_API_KEY=YOUR_NAVAMSHA_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional
OPENAI_MODEL=gpt-5.5
CORS_ORIGINS=*
PANCHANG_CACHE_TTL_SECONDS=86400
PANCHANG_CACHE_MAX_ENTRIES=2000

# Supabase Auth Send SMS Hook -> MSG91 (keep secrets in Render only)
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
SUPABASE_AUTH_SMS_HOOK_SECRET=
