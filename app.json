{
  "expo": {
    "name": "KAALAM",
    "slug": "kaalam-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaalam.app"
    },
    "android": {
      "package": "com.kaalam.app"
    },
    "scheme": "kaalam",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KAALAM to use your location while the app is open to calculate accurate local Panchangam timings."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/kaalam-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EB"
        }
      ]
    ]
  }
}
